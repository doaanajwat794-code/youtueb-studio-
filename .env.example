# Copy to .env (git-ignored) on your computer, or add these as secrets in the
# Claude Code cloud environment settings. NEVER commit real values.

# Google AI Studio key (paid tier) — Veo video, Gemini images, Gemini TTS, Lyria music
GEMINI_API_KEY=

# YouTube Data API key — research statistics only (free quota)
YOUTUBE_API_KEY=

# YouTube OAuth (Desktop app client) — private uploads to Twist Villa
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
