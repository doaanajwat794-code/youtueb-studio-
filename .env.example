# Copy to .env (git-ignored) on your computer, or add these as secrets in the
# Claude Code cloud environment settings. NEVER commit real values.

# OPTIONAL. Google AI Studio key — free tier is enough for Gemini TTS narration (option 2).
# Paid Veo API is NOT used (owner generates footage in Google Flow).
GEMINI_API_KEY=

# OPTIONAL. Free Google Cloud API key with the Drive API enabled — lets Claude download clips
# from a Drive folder shared as 'Anyone with the link' (fetch-drive).
GOOGLE_API_KEY=

# YouTube Data API key — research statistics only (free quota)
YOUTUBE_API_KEY=

# YouTube OAuth (Desktop app client) — private uploads to Twist Villa
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
